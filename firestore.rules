rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidVehicle(data) {
      return true;
    }

    function isValidArchive(data) {
      return true;
    }

    match /test/{docId} {
      allow read: if true;
    }

    match /vehicles/{vehicleId} {
      allow list: if true;
      allow get: if isValidId(vehicleId);
      allow create, update: if isValidId(vehicleId) && isValidVehicle(request.resource.data);
      allow delete: if isValidId(vehicleId);
    }

    match /archives/{archiveId} {
      allow list: if true;
      allow get: if isValidId(archiveId);
      allow create, update: if isValidId(archiveId) && isValidArchive(request.resource.data);
      allow delete: if isValidId(archiveId);
    }
  }
}
