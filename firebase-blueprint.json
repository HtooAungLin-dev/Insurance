{
  "entities": {
    "VehicleRecord": {
      "title": "VehicleRecord",
      "description": "Represents a vehicle insurance and rental ledger record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "month": { "type": "string", "enum": ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"] },
        "year": { "type": "number" },
        "srNo": { "type": "number" },
        "vehicleNo": { "type": "string", "maxLength": 100 },
        "vehicleModel": { "type": "string", "maxLength": 100 },
        "insuranceCompany": { "type": "string", "enum": ["Young", "GGI", "FNI", "KBZ", "MI"] },
        "ownerName": { "type": "string", "maxLength": 150 },
        "carValue": { "type": "number" },
        "windshieldValue": { "type": "number" },
        "premiumAmount": { "type": "number" },
        "validityPeriod": { "type": "string", "maxLength": 150 },
        "claimDate": { "type": "string", "maxLength": 100 },
        "commissionDate": { "type": "string", "maxLength": 100 },
        "remarks": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["Rental", "Done", "Reserved", "Active", "Claimed", "In Repair"] },
        "pickupArea": { "type": "string", "maxLength": 200 },
        "invoiceNo": { "type": "string", "maxLength": 50 },
        "isDraft": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": []
    },
    "ArchiveItem": {
      "title": "ArchiveItem",
      "description": "Represents an archived vehicle record with 7-day retention",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "archiveType": { "type": "string", "enum": ["deleted", "unfinished"] },
        "archivedAt": { "type": "number" },
        "expiresAt": { "type": "number" },
        "reason": { "type": "string", "maxLength": 300 },
        "record": { "$ref": "VehicleRecord" }
      },
      "required": ["archiveType", "archivedAt", "expiresAt"]
    }
  },
  "firestore": {
    "/vehicles/{vehicleId}": {
      "schema": "VehicleRecord",
      "description": "Collection of monthly vehicle rental and insurance ledger entries"
    },
    "/archives/{archiveId}": {
      "schema": "ArchiveItem",
      "description": "Collection of deleted records and unfinished drafts preserved for 7 days"
    }
  }
}
